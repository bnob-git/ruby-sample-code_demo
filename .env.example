# Copy to .env (loaded by dotenv) and fill in your ID.me app settings from https://developer.id.me
IDME_CLIENT_ID=YOUR_CLIENT_ID
IDME_CLIENT_SECRET=YOUR_CLIENT_SECRET
IDME_SCOPE=YOUR_SCOPE_VALUE
# IDME_REDIRECT_URI=http://localhost:4567/callback
# Use the local mock instead of api.id.me (see mock_idme.rb)
# IDME_BASE_URL=http://localhost:4568

# Cookie session encryption key (>= 64 bytes). Required when RACK_ENV=production (where the
# session cookie is also marked Secure, so serve over HTTPS); if left empty in development, a random one is generated per boot.
# Generate with: ruby -rsecurerandom -e 'puts SecureRandom.hex(64)'
SESSION_SECRET=
